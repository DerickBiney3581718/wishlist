# Database — get from Supabase, Neon, or Railway
DATABASE_URL="postgresql://postgres:secret@db-core:5432/tween_wishlist"

# Email — from resend.com
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
FROM_EMAIL="Tween Learning <noreply@tweenlearning.com>"
NOTIFICATION_EMAIL="hello@tweentechnologies.com"

# Auth — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here-generate-random-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# Admin login (used by the seed script — npm run seed)
ADMIN_EMAIL="admin@tweentechnologies.com"
ADMIN_PASSWORD="ChangeMe123!"
ADMIN_NAME="Tween Admin"

# App
NEXT_PUBLIC_APP_URL="https://wishlist.tweenlearning.com"
