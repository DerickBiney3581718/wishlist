generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model WishlistEntry {
  id          String   @id @default(cuid())
  fullName    String
  email       String   @unique
  phone       String
  country     String
  role        String
  courses     String[]
  note        String?  @db.Text
  gdprConsent Boolean  @default(true)
  ipAddress   String?
  source      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([email])
  @@index([createdAt])
  @@index([country])
  @@map("wishlist_entries")
}

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())

  @@map("admin_users")
}
